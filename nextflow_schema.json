                "adapter_3p": { "type": "string", "default": "AAAAAAAAAAAA" },
                "report_soloFeature": { "type": "string", "default": "GeneFull_Ex50pAS" },
                "STAR_param": { "type": "string" }
            }
        },
        "sweetseq_options": {
            "title": "Sweet-seq options",
            "type": "object",
            "description": "Sweet-seq assay specific options",
            "properties": {
                "barcode_fasta": { "type": "string" },
                "linker_fasta": { "type": "string" },
                "fq_pattern": { "type": "string" }
            }
        },
        "capture_virus_options": {
            "title": "Capture Virus options",
            "type": "object",
            "description": "Capture Virus assay specific options",
            "properties": {
                "virus_genomeDir": { "type": "string" },
                "fasta": { "type": "string" },
                "gtf": { "type": "string" },
                "genome_name": { "type": "string", "default": "genomeDir" },
                "minimum_length": { "type": "integer", "default": 20 },
                "nextseq_trim": { "type": "integer", "default": 20 },
                "overlap": { "type": "integer", "default": 10 },
                "cutadapt_param": { "type": "string", "default": "" },
                "skip_cutadapt": { "type": "boolean", "default": false },
                "threshold": { "type": "number", "default": 0.5 },
                "not_consensus": { "type": "boolean", "default": false },
                "min_consensus_read": { "type": "integer", "default": 2 },
